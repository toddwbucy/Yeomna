[Unit]
Description=Yeomna Document Extraction Service (Docling gRPC)
Documentation=https://github.com/toddwbucy/Yeomna
After=network.target systemd-tmpfiles-setup.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# UMask=0007 ensures the Unix domain socket is created group-connectable
# (0660/0770 family) at bind time — no post-bind chmod race. Matches the
# daemon unit. The in-server chmod remains as a fallback for non-systemd
# invocations and as an abort-if-unusable check.
UMask=0007
Type=simple
User=yeomna
Group=yeomna

# /run/yeomna is created solely by tmpfiles.d/yeomna.conf (shipped
# beside this unit as yeomna-tmpfiles.conf). Deliberately NO
# RuntimeDirectory= here: the reference's three service units shared RuntimeDirectory=yeomna,
# and systemd removes a unit's RuntimeDirectory on stop — so any one service
# stopping unlinked the OTHER services' live sockets (observed 2026-07-20:
# starting the extractor clobbered its sibling sockets).
# /var/cache/yeomna for HF model cache — referenced by ReadWritePaths below.
CacheDirectory=yeomna
CacheDirectoryMode=0755

WorkingDirectory=/home/todd/git/Yeomna/services
ExecStart=/home/todd/git/Yeomna/services/.venv/bin/python -m extraction.server

# Environment from config file
EnvironmentFile=/etc/yeomna/extractor.conf

# Restart policy
Restart=on-failure
RestartSec=10

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/run/yeomna /var/cache/yeomna

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yeomna-extractor

[Install]
WantedBy=multi-user.target
